# Copy this file to .env.local for local development.
# On Cloudflare Pages, add the same values under
# Settings -> Environment variables for Production and Preview.

# Canonical site origin used for metadata, canonicals, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://cognilogs.com

# PostHog project API key. This is a public, write-only key (phc_...).
# Analytics is disabled when this is empty.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog Cloud ingestion host.
# US: https://us.i.posthog.com
# EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
